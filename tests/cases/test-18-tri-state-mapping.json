            "history": [
              {"period": "2007", "value": 62},
              {"period": "2008", "value": 82},
              {"period": "2009", "value": 100}
            ],
            "history_basis": "trend",
            "drivers": ["煤炭价格"],
            "constraints": ["转移支付政策"],
            "quantity_price_relevant": true,
            "quantity_price_split": true,
            "qualitative_direction": "up",
            "forecast_low": 140,
            "forecast_high": 160,
            "center": 150,
            "probability": 0.7,
            "proposition": "P(2013 年地方财政收入 > 130 亿元)",
            "scored_event": {"type": "threshold", "op": ">", "value": 130},
            "reasoning": "按煤价外推",
            "failure_conditions": "煤价回落",
            "counterargument": "非煤产业占比低",
            "missing_info": "在产矿井达产率"
          }
        ]
      },
      "expect": {
        "must_block_codes": ["GATE_FIELD_UNCHECKED"],
        "must_not_codes": ["GATE_FIELD_UNKNOWN"],
        "lockable": false
      }
    },
    {
      "mode": "case",
      "note": "显式判定为'不涉及存量流量' → false，闸门通过。",
      "extract": {
