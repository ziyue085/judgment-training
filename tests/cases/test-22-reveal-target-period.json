{
  "id": "test-22-reveal-target-period",
  "title": "Test 22 · 揭晓必须对齐预测目标期（值对错了年份 = 整份作废）",
  "scenario": "v0.2.3 修复：旧实现只做 base_period == actual_period 的 WARN，完全不校验结果期末与 forecast_to。于是拿 2012 年的数字去结算 2013 年的预测也能通过。现在 actual_period_end 与目标期不一致 → REVEAL_TARGET_PERIOD_MISMATCH(BLOCK)。旧档案只写「2013」的年粒度仍兼容。",
  "steps": [
    {
      "mode": "reveal",
      "case": {
        "object_type": "city",
        "historical_cutoff": "2010-12-31",
        "forecast_to": "2013-12-31",
        "sources": [
          {
            "name": "某县 2009 年国民经济和社会发展统计公报",
            "published_at": "2010-03-15",
            "data_period_start": "2009-01-01",
            "data_period_end": "2009-12-31",
            "revision_status": "final"
          }
        ],
        "indicators": [
          {
            "name": "地方财政收入",
            "base_value": 500,
            "base_caliber": "全县、当年价",
            "base_period": "2009"
          }
        ],
        "outcomes": {
          "地方财政收入": {
            "actual_value": 800,
            "actual_unit": "亿元",
            "actual_caliber": "全县、当年价",
            "actual_period": "2013",
            "actual_period_end": "2013-12-31",
            "source": "某县 2013 年国民经济和社会发展统计公报",
            "published_at": "2014-04-10",
            "revision_status": "initial"
          }
        }
      },
      "expect": {
        "must_info_codes": ["REVEAL_OK"],
        "must_not_codes": ["REVEAL_TARGET_PERIOD_MISMATCH"]
      }
    },
    {
      "mode": "reveal",
      "case": {
        "object_type": "city",
        "historical_cutoff": "2010-12-31",
        "forecast_to": "2013-12-31",
        "sources": [
          {
            "name": "某县 2009 年国民经济和社会发展统计公报",
            "published_at": "2010-03-15",
            "data_period_start": "2009-01-01",
            "data_period_end": "2009-12-31",
            "revision_status": "final"
          }
        ],
        "indicators": [
          {
            "name": "地方财政收入",
            "base_value": 500,
            "base_caliber": "全县、当年价",
            "base_period": "2009"
          }
        ],
        "outcomes": {
          "地方财政收入": {
            "actual_value": 620,
            "actual_unit": "亿元",
            "actual_caliber": "全县、当年价",
            "actual_period": "2012",
            "actual_period_end": "2012-12-31",
            "source": "某县 2012 年国民经济和社会发展统计公报",
            "published_at": "2013-04-10",
            "revision_status": "initial"
          }
        }
      },
      "expect": {
        "must_block_codes": ["REVEAL_TARGET_PERIOD_MISMATCH"],
        "must_not_codes": ["REVEAL_OK"]
      }
    },
    {
      "mode": "reveal",
      "case": {
        "object_type": "city",
        "historical_cutoff": "2010-12-31",
        "forecast_to": "2013-12-31",
        "sources": [
          {
            "name": "某县 2009 年国民经济和社会发展统计公报",
            "published_at": "2010-03-15",
            "data_period_start": "2009-01-01",
            "data_period_end": "2009-12-31",
            "revision_status": "final"
          }
        ],
        "indicators": [
          {
            "name": "地方财政收入",
            "base_value": 500,
            "base_caliber": "全县、当年价",
            "base_period": "2009"
          }
        ],
        "outcomes": {
          "地方财政收入": {
            "actual_value": 800,
            "actual_unit": "亿元",
            "actual_caliber": "全县、当年价",
            "actual_period": "2013",
            "source": "某县 2013 年国民经济和社会发展统计公报",
            "published_at": "2014-04-10",
            "revision_status": "initial"
          }
        }
      },
      "expect": {
        "must_info_codes": ["REVEAL_OK"],
        "must_not_codes": ["REVEAL_TARGET_PERIOD_MISMATCH"]
      }
    }
  ]
}
