{
  "id": "test-23-full-pipeline-integration",
  "title": "Test 23 · 全链路贯通：草稿 → 可锁 → 揭晓 → 复盘评的是同一个事件",
  "scenario": "v0.2.3 的收官用例。把 CASE→ADMISSION→FORECAST→LOCKABLE→REVEAL→POSTMORTEM 串起来跑一遍，并且刻意选一个「区间没命中、但用户押的命题命中」的形态：区间 [480,520] 而命题是 GDP>420，实际 450。全链必须同时给出 interval_hit=false、scored_event_hit=true、Brier=0.04、verdict=过程好结果命中 —— 四项由同一份 actual_value 派生，任何一环断掉都会整体失败。",
  "steps": [
    {
      "mode": "case",
      "case": {
        "object_type": "city",
        "historical_cutoff": "2010-12-31",
        "forecast_to": "2013-12-31",
        "base_rate_provided": true,
        "sources": [
          {
            "name": "某县 2009 年国民经济和社会发展统计公报",
            "published_at": "2010-03-15",
            "data_period_start": "2009-01-01",
            "data_period_end": "2009-12-31",
            "revision_status": "final"
          }
        ],
        "indicators": [
          {
            "name": "GDP",
            "kind": "flow",
            "base_value": 300,
            "base_unit": "亿元",
            "base_caliber": "全县、当年价",
            "base_period": "2009",
            "base_published_at": "2010-03-15",
            "history": [
              {"period": "2006", "value": 200},
              {"period": "2007", "value": 240},
              {"period": "2008", "value": 270},
              {"period": "2009", "value": 300}
            ],
            "history_basis": "trend",
            "drivers": ["煤炭价格", "固定资产投资"],
            "constraints": ["产能上限"],
            "stock_flow_relevant": false,
            "quantity_price_relevant": true,
            "quantity_price_split": true,
            "qualitative_direction": "up",
            "forecast_low": 480,
            "forecast_high": 520,
            "center": 500,
            "probability": 0.8,
            "proposition": "P(2013 年 GDP > 420 亿元)",
            "scored_event": {"type": "threshold", "op": ">", "value": 420}
          }
        ]
      },
      "expect": {
